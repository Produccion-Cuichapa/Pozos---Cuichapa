{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "**/backups/**",
      "**/*backup*",
      "**/*_backup_*",
      "**/*_roto_*",
      "**/*estado_roto*",
      "auditoria*",
      "**/auditoria*",
      "database.rules*",
      "*.py",
      "README*",
      "**/*.log",
      "templates/*backup*",
      "templates/*BACKUP*",
      "plan_*",
      "respaldo_*",
      "*.txt",
      "Claude_Context/**",
      "**/Claude_Context/**",
      "**/historico_pozos.json",
      "**/historico_pozos.json.gz",
      "**/balance_ft_inicial.json",
      "**/balance_ft_inicial.json.gz",
      "**/pruebas-*.html",
      "**/pruebas-*.js",
      "**/.env",
      "**/.env.*",
      "**/private/**",
      "**/respaldos/**",
      "**/backend-definitivo/**",
      "**/.git/**",
      "**/.github/**",
      "**/backend-ft-admin/**",
      "**/functions/**",
      "**/pruebas-*",
      "**/.env*"
    ],
    "rewrites": [
      {
        "source": "/api/historicos/**",
        "function": {
          "functionId": "cuichapaHistoricos",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/ft/correcciones",
        "function": {
          "functionId": "ftAdminCorrecciones",
          "region": "us-central1"
        }
      },
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
